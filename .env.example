# Copy to .env.local and fill in. Never commit real values.

# Supabase (public URL and anon key are safe for the browser; protected by RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secret. Never prefix with NEXT_PUBLIC_. Used only for admin tasks, never in client code.
SUPABASE_SERVICE_ROLE_KEY=

# Public site address (used for sitemap, Open Graph and canonical URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact email shown on the Contact page. Leave blank to show a "not configured" note.
NEXT_PUBLIC_CONTACT_EMAIL=
